    "@aws-sdk/client-lambda": "^3.1144.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/lib-dynamodb": "^3.1144.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.3",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
